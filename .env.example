# --- Database -----------------------------------------------------------
# Supabase session pooler (IPv4) or direct connection (IPv6).
# Find the exact string in Supabase Dashboard → Connect → Session pooler.
# URL-encode special characters in the password (* → %2A).
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=no-verify

# --- Supabase Management API (for HTTPS migrations via npm run db:remote) --
# Personal access token: Supabase Dashboard → Account → Access Tokens.
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_ACCESS_TOKEN=sbp_...

# --- Anthropic ----------------------------------------------------------
# Preferred: no key at all — run `ant auth login` once (Claude subscription);
# the SDK picks up the stored profile automatically.
# Alternatives: export a short-lived subscription token via
#   ant auth print-credentials --env
# (sets ANTHROPIC_AUTH_TOKEN), or set a pay-as-you-go key:
# ANTHROPIC_API_KEY=sk-ant-...

# --- Research & enrichment (optional) ------------------------------------
# TAVILY_API_KEY=tvly-...     # web research for the --live research runner
# PDL_API_KEY=...             # People Data Labs firmographic enrichment (npm run enrich)

# Phase 5 — Communications (Resend V1)
# Create the API key + webhook in the Resend dashboard; verify BOTH domains there.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_OUTBOUND_DOMAIN=engage.pursuitos.io
EMAIL_THREADS_DOMAIN=threads.pursuitos.io
